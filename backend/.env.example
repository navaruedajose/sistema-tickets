# =====================================================================
# Variables de entorno del backend (ejecucion local sin Docker)
# Copiar a .env:  cp .env.example .env
# =====================================================================

NODE_ENV=development
PORT=4000

# --- Base de datos ---------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tickets_db
DB_USER=tickets_user
DB_PASSWORD=tickets_pass
DB_POOL_MAX=10

# --- Seguridad -------------------------------------------------------
JWT_SECRETO=secreto_local_solo_para_desarrollo_cambiar_en_produccion_1234567890
JWT_EXPIRA_EN=15m
JWT_REFRESH_EXPIRA_EN=7d

# --- CORS ------------------------------------------------------------
CORS_ORIGENES=http://localhost:5173

# --- Archivos --------------------------------------------------------
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=10

# --- Correo / SMS ----------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-responder@sistema-tickets.local

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
