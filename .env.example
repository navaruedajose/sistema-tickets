# =====================================================================
# SISTEMA DE TICKETS - Variables de entorno para Docker Compose
# Copiar a .env antes de ejecutar:  cp .env.example .env
# NUNCA subir el archivo .env al repositorio.
# =====================================================================

# --- Base de datos ---------------------------------------------------
POSTGRES_DB=tickets_db
POSTGRES_USER=tickets_user
POSTGRES_PASSWORD=tickets_pass
POSTGRES_PORT=5432

# --- Puertos expuestos -----------------------------------------------
BACKEND_PORT=4000
FRONTEND_PORT=5173
ADMINER_PORT=8080

# --- Entorno ---------------------------------------------------------
NODE_ENV=production
TZ=America/Mexico_City

# --- Seguridad -------------------------------------------------------
# Generar uno con:  openssl rand -hex 48
JWT_SECRETO=cambia_esto_por_un_secreto_largo_y_aleatorio_de_96_caracteres_minimo
JWT_EXPIRA_EN=15m
JWT_REFRESH_EXPIRA_EN=7d

# --- CORS (lista separada por comas) ---------------------------------
CORS_ORIGENES=http://localhost:5173,http://localhost:4173

# --- Carga de archivos -----------------------------------------------
UPLOAD_MAX_MB=10

# --- Almacenamiento de evidencias (Cloudinary) -----------------------
# Las fotos y demas evidencias se pueden guardar en Cloudinary en lugar
# del disco del servidor. En la nube es casi obligatorio: los planes
# gratuitos tienen disco EFIMERO y cada redespliegue borra los archivos.
#
#   STORAGE_DRIVER=auto        usa Cloudinary si hay credenciales y, si
#                              no, guarda en disco (recomendado).
#   STORAGE_DRIVER=cloudinary  obliga a usar Cloudinary; falla al arrancar
#                              si faltan las credenciales.
#   STORAGE_DRIVER=local       obliga a usar disco aunque haya credenciales.
#
# Las tres credenciales se copian del panel de Cloudinary:
#   Dashboard -> Settings -> API Keys
STORAGE_DRIVER=auto
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sistema-tickets

# --- Pool de conexiones a PostgreSQL ---------------------------------
# Es el primer cuello de botella bajo carga. PostgreSQL acepta hasta
# 100 conexiones; subirlo a 30-50 mejora mucho la latencia con
# muchos usuarios concurrentes. Con 10 (el valor por defecto), 100
# usuarios concurrentes hacen cola esperando una conexion libre.
DB_POOL_MAX=10

# TLS hacia PostgreSQL. En Docker local debe quedarse en false; en un
# proveedor gestionado (Render, Railway, RDS) hay que ponerlo en true.
DB_SSL=false

# --- Limites de tasa (rate limiting) ---------------------------------
# Peticiones permitidas por IP dentro de la ventana, para toda la API.
# OJO: el limitador guarda los contadores EN MEMORIA, asi que reiniciar
# el backend los pone a cero:  docker compose restart backend
# Si vas a ejecutar la verificacion automatica o k6 varias veces seguidas,
# sube este valor para no chocar con el 429.
#
#   RATE_LIMIT_MAX=0  ->  DESACTIVA el limitador por completo.
#   Usalo solo para medir la capacidad real con la prueba de carga de k6:
#   con el limitador activo, k6 agota la cuota y termina midiendo el
#   limitador en lugar del sistema. Vuelve a ponerlo en 300 despues.
RATE_LIMIT_MAX=300
# Duracion de la ventana, en milisegundos (900000 = 15 minutos).
RATE_LIMIT_WINDOW_MS=900000
# Intentos de inicio de sesion FALLIDOS permitidos por ventana.
# Los aciertos no consumen cuota. 0 desactiva este limitador.
LOGIN_RATE_LIMIT_MAX=10
# Operaciones costosas (crear ticket, subir evidencia, reportes) por
# minuto. ESTE es el limite que frena una prueba de carga sobre la
# creacion de tickets: con 20/min, k6 a 20 peticiones/segundo recibe
# un 95% de 429. 0 lo desactiva.
RATE_LIMIT_COSTOSAS_MAX=20

# --- Notificaciones por correo (SMTP) --------------------------------
# Si se dejan vacias, el sistema funciona en modo "consola" (log en vez
# de envio real), lo cual es ideal para la demo universitaria.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-responder@sistema-tickets.local

# --- Notificaciones por SMS (Twilio) ---------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
