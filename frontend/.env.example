# =====================================================================
# Variables de entorno del frontend
# Copiar a .env:  cp .env.example .env
# =====================================================================

# URL base de la API.
# En desarrollo puede dejarse VACIA: el proxy de Vite reenvia /api al backend
# y asi se evita cualquier problema de CORS.
#
# En produccion (imagen nginx) tambien puede dejarse vacia, porque nginx
# reenvia /api al servicio backend dentro de la red de Docker.
#
# Solo se define cuando el frontend y el backend viven en dominios distintos:
#   VITE_API_URL=https://api.mi-dominio.com/api/v1
VITE_API_URL=

# Solo para el proxy de desarrollo (no se usa en el build de produccion)
VITE_API_PROXY=http://localhost:4000
